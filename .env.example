DATABASE_URL=postgres://cardcalendar:cardcalendar@localhost:5432/cardcalendar
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-random-secret
USE_DATABASE=false
DATABASE_POOL_MAX=10
AUTH_DEV_HEADER=false
CSRF_TRUSTED_ORIGINS=
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_EXPORT_MAX=3
RATE_LIMIT_EXPORT_WINDOW_SECONDS=600
RATE_LIMIT_DELETE_MAX=3
RATE_LIMIT_DELETE_WINDOW_SECONDS=3600
WORKER_HEARTBEAT_NAME=primary
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
