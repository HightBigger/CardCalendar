# Copy to .env.production and keep that file outside version control.
# Empty secret values are intentional; generate them in the deployment secret store.
POSTGRES_DB=cardcalendar
POSTGRES_USER=cardcalendar
POSTGRES_PASSWORD=
POSTGRES_IMAGE=postgres:16-alpine

# URL-encode the database password before embedding it in this connection string.
DATABASE_URL=
DATABASE_POOL_MAX=10
APP_URL=https://cardcalendar.example.com
CSRF_TRUSTED_ORIGINS=
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_EXPORT_MAX=3
RATE_LIMIT_EXPORT_WINDOW_SECONDS=600
RATE_LIMIT_DELETE_MAX=3
RATE_LIMIT_DELETE_WINDOW_SECONDS=3600
WORKER_HEARTBEAT_NAME=primary
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_MAX_AGE_SECONDS=90

WEB_IMAGE=cardcalendar-web:local
WORKER_IMAGE=cardcalendar-worker:local
WEB_PORT=3000
